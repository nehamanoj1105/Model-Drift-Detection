\newlabel{sec:ablation}{{\mbox  {V-G}}{4}{}{subsection.5.7}{}}
\@writefile{lot}{\contentsline {table}{\numberline {II}{\ignorespaces Primary comparison and cost, mean over seeds 42--46. Bold marks the best macro-F1 per stream; CPU and runtime in seconds, events are counts.}}{5}{}\protected@file@percent }
\newlabel{tab:primary}{{II}{5}{}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Adaptation CPU on the two largest streams. The ordering is the reverse of Fig.~\ref {fig:primary}: on UGR'16, RAPT uses an order of magnitude less adaptation time than Full Retraining and records lower macro-F1.}}{5}{}\protected@file@percent }
\newlabel{fig:cost}{{4}{5}{}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Accuracy--cost trade-off on all four streams, measured against Full Retraining at the origin. Circles are RAPT and squares are RAPT-Enhanced, computed from Table~\ref {tab:primary}. Up and to the right is better. Squares left of zero cost more adaptation CPU than Full Retraining.}}{5}{}\protected@file@percent }
\newlabel{fig:scatter}{{5}{5}{}{figure.5}{}}
\@writefile{lot}{\contentsline {table}{\numberline {III}{\ignorespaces Performance of different configurations of RAPT using the 5G Campus stream, averaged over multiple random seeds.}}{5}{}\protected@file@percent }
\newlabel{tab:ablation}{{III}{5}{}{table.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Ablation ladder comparing the different configurations of RAPT, evaluated on the 5G Campus stream. As shown, RAPT-Cheap matches the full retrainer in terms of macro-F1 at around $40\%$ less adaptation CPU, whereas RAPT-Incremental performs worse on both accuracy and cost. }}{6}{}\protected@file@percent }
\newlabel{fig:ablation}{{6}{6}{}{figure.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces Relationship between accuracy and cost of different versions of RAPT processed using data from the 5G Campus stream. We see that RAPT-Cheap achieves similar macro-F1 values at lower adaptation CPUs than those achieved by the full retrainer, while all detectors that were conservative did not generate any triggers and therefore coincided with the frozen baseline on both dimensions. }}{6}{}\protected@file@percent }
\newlabel{fig:tradeoff}{{7}{6}{}{figure.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {V-H}}Determinants of Cost and Trigger Behavior}{6}{}\protected@file@percent }
\newlabel{sec:cost}{{\mbox  {V-H}}{6}{}{subsection.5.8}{}}
\newlabel{sec:trigger}{{\mbox  {V-H}}{6}{}{figure.7}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Historical detectors comparison. Since ADWIN, Page-Hinkley and EDMA never fire they replicate the frozen baseline exactly. EDD fires most often and produces the highest macro-F1 at the highest adaptation cost. In contrast to these behaviors, RAPT has adapted less frequently than all but two of the methods studied here (and less accurately). }}{6}{}\protected@file@percent }
\newlabel{fig:detector}{{8}{6}{}{figure.8}{}}
