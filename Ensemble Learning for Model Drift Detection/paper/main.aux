\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Macro-F1 on the two largest cross-dataset streams. On UGR'16, RAPT tracks the frozen baseline and not the retrained models, which is the signature of stale policy reuse. On the 5G NR stream all five models are within $0.0133$.}}{4}{}\protected@file@percent }
\newlabel{fig:primary}{{2}{4}{}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Rolling accuracy over evaluation windows on UGR'16. RAPT sags once reused policies go stale, and the parity refit in RAPT-Enhanced pulls accuracy back toward Full Retraining. Vertical ticks mark parity refits.}}{4}{}\protected@file@percent }
\newlabel{fig:ugr_rolling}{{3}{4}{}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {\mbox  {V-F}}Computational Cost and Policy Reuse}{4}{}\protected@file@percent }
